# Copy this file to .env and fill in real values.

# Leave DATABASE_URL unset to fall back to local SQLite (data/gold.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gold_db

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Ticker used for gold futures on Yahoo Finance
GOLD_TICKER=GC=F

# Directory where trained model artifacts are stored
MODEL_DIR=data/models
